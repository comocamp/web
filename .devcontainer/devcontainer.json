{
  "name": "comocamp-web",
  "dockerComposeFile": "../docker-compose.yaml",
  "service": "hugo",
  "workspaceFolder": "/site",
  "overrideCommand": true,
  "postCreateCommand": "apk add --no-cache ripgrep bash",
  "portsAttributes": {
    "1313": {
      "label": "ComoCamp preview",
      "onAutoForward": "openBrowser"
    }
  },
  "customizations": {
    "vscode": {
      "settings": {
        "todo-tree.ripgrep.ripgrep": "/usr/bin/rg"
      },
      "extensions": [
        "budparr.language-hugo-vscode",
        "rusnasonov.vscode-hugo",
        "gydunhn.hugo-essentials",
        "eliostruyf.vscode-hugo-themer"
      ]
    }
  }
}
