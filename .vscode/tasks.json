{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Hugo: Fast preview (without archives)",
			"type": "process",
			"command": "hugo",
			"args": [
				"server",
				"--buildDrafts",
				"--renderToMemory",
				"--disableFastRender",
				"--poll",
				"700ms",
				"--bind",
				"0.0.0.0",
				"--port",
				"1313",
				"--config",
				"hugo.toml,hugo.fast.toml"
			],
			"isBackground": true,
			"problemMatcher": [],
			"group": {
				"kind": "build",
				"isDefault": false
			}
		}
	]
}